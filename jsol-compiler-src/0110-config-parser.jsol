// @JSOL v0.2.97 - Targets Configuration Normalizer (generic, target-agnostic)
const $mNormalizeTargetsConfig = function($mRawConfig) {
    JSOL.use($mBackendRegistry);

    const $aTargetIds = Map.keys($mBackendRegistry);
    const $mResult = Map.create();

    for (let $i = 0; $i < Arr.len($aTargetIds); $i = $i + 1) {
        const $saTargetId = $aTargetIds[$i];
        const $mEmptySub = Map.create();
        $mResult[$saTargetId] = Map.create("default", "", "targets", $mEmptySub);
    }

    if ($mRawConfig === null) {
        return $mResult;
    }

    for (let $i = 0; $i < Arr.len($aTargetIds); $i = $i + 1) {
        const $saTargetId = $aTargetIds[$i];
        if (Map.has($mRawConfig, $saTargetId) === true) {
            const $mSub = $mRawConfig[$saTargetId];
            if (Map.has($mSub, "default") === true) {
                $mResult[$saTargetId]["default"] = $mSub["default"];
            }
            if (Map.has($mSub, "targets") === true) {
                $mResult[$saTargetId]["targets"] = $mSub["targets"];
            }
        }
    }

    if (Map.has($mRawConfig, "default") === true && Map.has($mRawConfig, "targets") === true) {
        for (let $i = 0; $i < Arr.len($aTargetIds); $i = $i + 1) {
            const $saTargetId = $aTargetIds[$i];
            $mResult[$saTargetId]["default"] = $mRawConfig["default"];
            $mResult[$saTargetId]["targets"] = $mRawConfig["targets"];
        }
    }

    return $mResult;
};