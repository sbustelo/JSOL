{
  "version": "0.2.97",
  "target": "php",
  "meta": {
    "templates": {
      "shadow_map_ref": "mJSOL_{root}_ok"
    }
  },
  "transforms": {
    "TRUNC_CHECKED": {
      "template": "Math::trunc({1})"
    },
    "implicit": {
      "template": "(float)({1})"
    },
    "Cast.toStr": {
      "template": "Cast::toStr({1})"
    },
    "Cast.toInt": {
      "template": "Cast::toInt({1})"
    },
    "Cast.toFloat": {
      "template": "Cast::toFloat({1})"
    }
  },
  "operations": {
    "Str.concat": { "template": "Str::concat({*})" },
    "Str.sub": { "template": "mb_substr({0}, {1}, {2}, \"UTF-8\")" },
    "Str.len": { "template": "mb_strlen({0}, \"UTF-8\")" },
    "Str.indexOf": { "template": "Str::indexOf({0}, {1})" },
    "Str.char": { "template": "mb_ord(mb_substr({0}, {1}, 1, \"UTF-8\"), \"UTF-8\")" },
    "Str.fromChar": { "template": "mb_chr({0}, \"UTF-8\")" },
    "Str.upper": { "template": "mb_strtoupper({0}, \"UTF-8\")" },
    "Str.lower": { "template": "mb_strtolower({0}, \"UTF-8\")" },
    "Str.trim": { "template": "trim({0})" },
    "Str.split": { "template": "Str::split({0}, {1})" },
    "Str.contains": { "template": "Str::contains({0}, {1})" },
    "Str.startsWith": { "template": "str_starts_with({0}, {1})" },
    "Str.endsWith": { "template": "str_ends_with({0}, {1})" },
    "Str.replaceAll": { "template": "str_replace({1}, {2}, {0})" },
    "Str.replace": { "template": "str_replace({1}, {2}, {0})" },
    "Str.same": { "template": "Str::same({0}, {1}, {2})" },
    "Str.padStart": { "template": "Str::padStart({0}, {1}, {2})" },
    "Str.padEnd": { "template": "Str::padEnd({0}, {1}, {2})" },
    "Str.repeat": { "template": "str_repeat({0}, {1})" },
    "Str.eq": { "template": "({0} === {1})" },
    "Str.neq": { "template": "({0} !== {1})" },
    "Arr.len": { "template": "count({0})" },
    "Arr.count": { "template": "count({0})" },
    "Arr.push": { "template": "{0}[] = {1}" },
    "Arr.pop": { "template": "Arr::pop({0})" },
    "Arr.shift": { "template": "Arr::shift({0})" },
    "Arr.unshift": { "template": "array_unshift({0}, {1})" },
    "Arr.slice": { "template": "array_slice({0}, {1}, {2})" },
    "Arr.indexOf": { "template": "Arr::indexOf({0}, {1})" },
    "Arr.join": { "template": "implode({1}, {0})" },
    "Arr.contains": { "template": "in_array({1}, {0}, true)" },
    "Arr.sort": { "template": "Arr::sort({0}, {1})" },
    "Map.has": { "template": "isset({0}[{1}])" },
    "Map.keys": { "template": "array_keys({0})" },
    "Map.values": { "template": "array_values({0})" },
    "Map.count": { "template": "count({0})" },
    "Map.create": { "template": "JSOL::dict({*})" },
    "Map.get": { "template": "Map::get({0}, {1})" },
    "Math.eq": { "template": "({0} === {1})" },
    "Math.neq": { "template": "({0} !== {1})" },
    "Math.gt": { "template": "({0} > {1})" },
    "Math.lt": { "template": "({0} < {1})" },
    "Math.gte": { "template": "({0} >= {1})" },
    "Math.lte": { "template": "({0} <= {1})" },
    "Bool.and": { "template": "JSOL_Bool::and({*})" },
    "Bool.or": { "template": "JSOL_Bool::or({*})" },
    "Bool.xor": { "template": "JSOL_Bool::xor({*})" },
    "Bool.not": { "template": "(!{0})" },
    "Bool.eq": { "template": "JSOL_Bool::eq({*})" },
    "Bool.neq": { "template": "JSOL_Bool::neq({*})" },
    "Cast.toInt": { "template": "Cast::toInt({0})" },
    "Cast.toStr": { "template": "Cast::toStr({0})" },
    "Cast.toFloat": { "template": "Cast::toFloat({0})" },
    "Bit.and": { "template": "({0} & {1})" },
    "Bit.or": { "template": "({0} | {1})" },
    "Bit.xor": { "template": "({0} ^ {1})" },
    "Bit.not": { "template": "(~{0})" },
    "Bit.shiftL": { "template": "({0} << {1})" },
    "Bit.shiftR": { "template": "({0} >> {1})" },
    "Regex.match": { "template": "Rgx::match({0}, {1}, {2})" },
    "Regex.replace": { "template": "Rgx::replace({0}, {1}, {2}, {3})" },
    "Regex.test": { "template": "Rgx::test({0}, {1}, {2})" },
    "JSOL.hasKey": { "template": "isset({0}[{1}])" },
    "JSOL.len": { "template": "mb_strlen({0}, \"UTF-8\")" },
    "JSOL.count": { "template": "count({0})" },
    "JSOL.set": { "template": "/* mem-op */" },
    "JSOL.unset": { "template": "/* mem-op */" },
    "JSOL.ok": { "template": "JSOL::ok()" },
    "JSOL.resetShadow": { "template": "JSOL::resetShadow()" },
    "JSOL.JS": { "type": "block", "template": "strip" },
    "JSOL.PHP": { "type": "block", "template": "unwrap" },
    "JSOL.PY": { "type": "block", "template": "strip" },
    "JSOL.use": { "type": "regex", "search": "function\\s*\\(([^)]*)\\)\\s*\\{(?:\\s|__JSOL_COM_\\d+__)*JSOL\\.use\\s*\\(([^)]+)\\)\\s*;?", "template": "function($1) use ($2) {\n" },
    "JSOL.range": { "type": "range", "template": "" },
    "isNaN": { "template": "is_nan({0})" },
    "Math.abs": { "template": "abs({0})" },
    "Math.pow": { "template": "pow({0}, {1})" },
    "Math.sqrt": { "template": "sqrt({0})" },
    "Math.cbrt": { "template": "Math::cbrt({0})" },
    "Math.floor": { "template": "floor({0})" },
    "Math.ceil": { "template": "ceil({0})" },
    "Math.trunc": { "template": "Math::trunc({0})" },
    "Math.sum": { "template": "Math::sum({*})" },
    "Math.sub": { "template": "Math::sub({*})" },
    "Math.mul": { "template": "Math::mul({*})" },
    "Math.div": { "template": "Math::div({*})" },
    "Math.idiv": { "template": "Math::idiv({0}, {1})" },
    "Math.modX": { "template": "Math::modX({0}, {1})" },
    "Math.roundX": { "template": "Math::roundX({0})" },

"Math.logX": { "template": "Math::logX({0}, {1})" },
    "Math.ln": { "template": "Math::ln({0})" },
    "Math.min": { "template": "min({*})" },
    "Math.max": { "template": "max({*})" },
    "Cast.toBool": { "template": "Cast::toBool({0})" },
    "Math.E": { "type": "replace", "template": "M_E" },
    "Math.PI": { "type": "replace", "template": "M_PI" },

    "Math.sin": { "template": "sin({0})" },
    "Math.cos": { "template": "cos({0})" },
    "Math.tan": { "template": "tan({0})" },
    "Math.asin": { "template": "asin({0})" },
    "Math.acos": { "template": "acos({0})" },
    "Math.atan": { "template": "atan({0})" },
    "Math.atan2": { "template": "atan2({0}, {1})" }
  }
}