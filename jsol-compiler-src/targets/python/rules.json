{
  "version": "0.2.97",
  "target": "python",
  "meta": {
    "templates": {
      "shadow_map_ref": "mJSOL_{root}_ok"
    }
  },
  "transforms": {
    "TRUNC_CHECKED": {
      "template": "math.trunc({1})"
    },
    "implicit": {
      "template": "float({1})"
    },
    "Cast.toStr": {
      "template": "JSOL.to_str({1})"
    },
    "Cast.toInt": {
      "template": "JSOL.to_int({1})"
    },
    "Cast.toFloat": {
      "template": "JSOL.to_float({1})"
    }
  },
  "operations": {
    "PY_Header": { "type": "regex", "search": "^", "template": "import math\nimport functools\nfrom jsol_core import JSOL\n\n" },
    "Str.concat": { "template": "\"\".join(JSOL.to_str(_x) for _x in [{*}])" },
    "Str.sub": { "template": "{0}[({1}):({1})+({2})]" },
    "Str.len": { "template": "len({0})" },
    "Str.indexOf": { "template": "JSOL.str_index_of({0}, {1})" },
    "Str.char": { "template": "ord({0}[{1}])" },
    "Str.fromChar": { "template": "chr({0})" },
    "Str.upper": { "template": "{0}.upper()" },
    "Str.lower": { "template": "{0}.lower()" },
    "Str.trim": { "template": "{0}.strip()" },
    "Str.split": { "template": "JSOL.str_split({0}, {1})" },
    "Str.contains": { "template": "({1} in {0})" },
    "Str.startsWith": { "template": "{0}.startswith({1})" },
    "Str.endsWith": { "template": "{0}.endswith({1})" },
    "Str.replaceAll": { "template": "{0}.replace({1}, {2})" },
    "Str.replace": { "template": "{0}.replace({1}, {2})" },
    "Str.same": { "template": "JSOL.str_same({0}, {1}, {2})" },
    "Str.padStart": { "template": "JSOL.str_pad_start({0}, {1}, {2})" },
    "Str.padEnd": { "template": "JSOL.str_pad_end({0}, {1}, {2})" },
    "Str.repeat": { "template": "({0} * {1})" },
    "Str.eq": { "template": "({0} == {1})" },
    "Str.neq": { "template": "({0} != {1})" },
    "Arr.len": { "template": "len({0})" },
    "Arr.count": { "template": "len({0})" },
    "Arr.push": { "template": "{0}.append({1})" },
    "Arr.pop": { "template": "JSOL.arr_pop({0})" },
    "Arr.shift": { "template": "JSOL.arr_shift({0})" },
    "Arr.unshift": { "template": "{0}.insert(0, {1})" },
    "Arr.slice": { "template": "{0}[{1}:{2}]" },
    "Arr.indexOf": { "template": "JSOL.arr_index_of({0}, {1})" },
    "Arr.join": { "template": "{1}.join(str(_x) for _x in {0})" },
    "Arr.contains": { "template": "({1} in {0})" },
    "Arr.sort": { "template": "sorted({0}, key=functools.cmp_to_key({1}))" },
    "Map.has": { "template": "({1} in {0})" },
    "Map.keys": { "template": "list({0}.keys())" },
    "Map.values": { "template": "list({0}.values())" },
    "Map.count": { "template": "len({0})" },
    "Map.create": { "template": "JSOL.dict({*})" },
    "Map.get": { "template": "JSOL.map_get({0}, {1})" },
    "Math.eq": { "template": "({0} == {1})" },
    "Math.neq": { "template": "({0} != {1})" },
    "Math.gt": { "template": "({0} > {1})" },
    "Math.lt": { "template": "({0} < {1})" },
    "Math.gte": { "template": "({0} >= {1})" },
    "Math.lte": { "template": "({0} <= {1})" },
    "Bool.and": { "template": "JSOL.bool_and({*})" },
    "Bool.or": { "template": "JSOL.bool_or({*})" },
    "Bool.xor": { "template": "JSOL.bool_xor({*})" },
    "Bool.not": { "template": "(not {0})" },
    "Bool.eq": { "template": "JSOL.bool_eq({*})" },
    "Bool.neq": { "template": "({0} != {1})" },
    "Cast.toInt": { "template": "JSOL.to_int({0})" },
    "Cast.toStr": { "template": "JSOL.to_str({0})" },
    "Cast.toFloat": { "template": "JSOL.to_float({0})" },
    "Bit.and": { "template": "({0} & {1})" },
    "Bit.or": { "template": "({0} | {1})" },
    "Bit.xor": { "template": "({0} ^ {1})" },
    "Bit.not": { "template": "(~{0})" },
    "Bit.shiftL": { "template": "({0} << {1})" },
    "Bit.shiftR": { "template": "({0} >> {1})" },
    "Regex.match": { "template": "JSOL.regex_match({0}, {1}, {2})" },
    "Regex.replace": { "template": "JSOL.regex_replace({0}, {1}, {2}, {3})" },
    "Regex.test": { "template": "JSOL.regex_test({0}, {1}, {2})" },
    "JSOL.hasKey": { "template": "({1} in {0})" },
    "JSOL.len": { "template": "len({0})" },
    "JSOL.count": { "template": "len({0})" },
    "JSOL.set": { "template": "# mem-op" },
    "JSOL.unset": { "template": "# mem-op" },
    "JSOL.ok": { "template": "JSOL.ok()" },
    "JSOL.resetShadow": { "template": "JSOL.reset_shadow()" },
    "JSOL.eval": { "template": "JSOL.eval({0})" },
    "JSOL.JS": { "type": "block", "template": "strip" },
    "JSOL.PHP": { "type": "block", "template": "strip" },
    "JSOL.PY": { "type": "block", "template": "unwrap" },
    "JSOL.use": { "type": "regex", "search": "JSOL\\.use\\s*\\([^)]+\\)\\s*;?", "template": "" },
    "JSOL.range": { "type": "range", "template": "" },
    "isNaN": { "template": "math.isnan({0})" },
    "Math.abs": { "template": "abs({0})" },

"Math.pow": { "template": "JSOL.math_pow({0}, {1})" },
    "Math.sqrt": { "template": "math.sqrt({0})" },
    "Math.cbrt": { "template": "JSOL.math_cbrt({0})" },
    "Math.floor": { "template": "math.floor({0})" },
    "Math.ceil": { "template": "math.ceil({0})" },
    "Math.trunc": { "template": "math.trunc({0})" },
    "Math.sum": { "template": "JSOL.math_sum({*})" },
    "Math.sub": { "template": "JSOL.math_sub({*})" },
    "Math.mul": { "template": "JSOL.math_mul({*})" },
    "Math.div": { "template": "JSOL.math_div({*})" },
    "Math.idiv": { "template": "JSOL.math_idiv({0}, {1})" },
    "Math.modX": { "template": "JSOL.math_modx({0}, {1})" },
    "Math.roundX": { "template": "(math.floor(abs({0}) + 0.5) * (1 - 2 * (({0}) < 0)))" },
    "Math.logX": { "template": "math.log({0}, {1})" },
    "Math.ln": { "template": "math.log({0})" },
    "Math.min": { "template": "min({*})" },
    "Math.max": { "template": "max({*})" },
    "Cast.toBool": { "template": "JSOL.to_bool({0})" },

    "Math.E": { "type": "replace", "template": "math.e" },
    "Math.PI": { "type": "replace", "template": "math.pi" },
    "Math.sin": { "template": "math.sin({0})" },
    "Math.cos": { "template": "math.cos({0})" },
    "Math.tan": { "template": "math.tan({0})" },
    "Math.asin": { "template": "math.asin({0})" },
    "Math.acos": { "template": "math.acos({0})" },
    "Math.atan": { "template": "math.atan({0})" },
    "Math.atan2": { "template": "math.atan2({0}, {1})" }
  }
}