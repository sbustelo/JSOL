[
  { "id": "TS_Header", "type": "regex", "search": "^", "template": "declare var JSOL: any;\ndeclare var Rgx: any;\n\n" },
  { "id": "TS_Params", "type": "paramtype", "template": "" },
  { "id": "TS_Num", "type": "regex", "search": "(^|\\s|\\{)(const|let)\\s+(\\$[iqn]\\w*)\\s*=", "template": "$1$2 $3: number =" },
  { "id": "TS_Str", "type": "regex", "search": "(^|\\s|\\{)(const|let)\\s+(\\$s\\w*)\\s*=", "template": "$1$2 $3: string =" },
  { "id": "TS_Bool", "type": "regex", "search": "(^|\\s|\\{)(const|let)\\s+(\\$b\\w*)\\s*=", "template": "$1$2 $3: boolean =" },
  { "id": "TS_Arr", "type": "regex", "search": "(^|\\s|\\{)(const|let)\\s+(\\$a\\w*)\\s*=", "template": "$1$2 $3: any[] =" },
  { "id": "TS_Map", "type": "regex", "search": "(^|\\s|\\{)(const|let)\\s+(\\$m\\w*)\\s*=", "template": "$1$2 $3: Record<string, any> =" },
  { "id": "TS_Func_Num", "type": "regex", "search": "(^|\\s|\\{)(const|let)\\s+(\\$[iqn]\\w*):\\s*number\\s*=\\s*function\\s*\\(([^)]*)\\)", "template": "$1$2 $3 = function($4): number" },
  { "id": "TS_Func_Str", "type": "regex", "search": "(^|\\s|\\{)(const|let)\\s+(\\$s\\w*):\\s*string\\s*=\\s*function\\s*\\(([^)]*)\\)", "template": "$1$2 $3 = function($4): string" },
  { "id": "TS_Func_Bool", "type": "regex", "search": "(^|\\s|\\{)(const|let)\\s+(\\$b\\w*):\\s*boolean\\s*=\\s*function\\s*\\(([^)]*)\\)", "template": "$1$2 $3 = function($4): boolean" },
  { "id": "TS_Func_Arr", "type": "regex", "search": "(^|\\s|\\{)(const|let)\\s+(\\$a\\w*):\\s*any\\[\\]\\s*=\\s*function\\s*\\(([^)]*)\\)", "template": "$1$2 $3 = function($4): any[]" },
  { "id": "TS_Func_Map", "type": "regex", "search": "(^|\\s|\\{)(const|let)\\s+(\\$m\\w*):\\s*Record<string,\\s*any>\\s*=\\s*function\\s*\\(([^)]*)\\)", "template": "$1$2 $3 = function($4): Record<string, any>" },
  { "id": "Str.concat", "type": "call", "template": "[{*}].join(\"\")" },
  { "id": "Str.sub", "type": "call", "template": "{0}.substring({1}, ({1}) + ({2}))" },
  { "id": "Str.len", "type": "call", "template": "{0}.length" },
  { "id": "Str.indexOf", "type": "call", "template": "{0}.indexOf({1})" },
  { "id": "Str.replace", "type": "call", "template": "{0}.split({1}).join({2})" },
  { "id": "Str.char", "type": "call", "template": "{0}.charCodeAt({1})" },
  { "id": "Str.fromChar", "type": "call", "template": "String.fromCharCode({0})" },
  { "id": "Str.upper", "type": "call", "template": "{0}.toUpperCase()" },
  { "id": "Str.lower", "type": "call", "template": "{0}.toLowerCase()" },
  { "id": "Str.trim", "type": "call", "template": "{0}.trim()" },
  { "id": "Str.split", "type": "call", "template": "{0}.split({1})" },
  { "id": "Arr.count", "type": "call", "template": "{0}.length" },
  { "id": "Arr.push", "type": "call", "template": "{0}.push({1})" },
  { "id": "Arr.pop", "type": "call", "template": "{0}.pop()" },
  { "id": "Arr.shift", "type": "call", "template": "{0}.shift()" },
  { "id": "Arr.slice", "type": "call", "template": "{0}.slice({1}, {2})" },
  { "id": "Arr.indexOf", "type": "call", "template": "{0}.indexOf({1})" },
  { "id": "Arr.join", "type": "call", "template": "{0}.join({1})" },
  { "id": "Map.has", "type": "call", "template": "Object.prototype.hasOwnProperty.call({0}, {1})" },
  { "id": "Map.keys", "type": "call", "template": "Object.keys({0})" },
  { "id": "Map.create", "type": "call", "template": "JSOL.dict({*})" },
  { "id": "Cast.toInt", "type": "call", "template": "parseInt({0}, 10)" },
  { "id": "Cast.toStr", "type": "call", "template": "String({0})" },
  { "id": "Cast.toFloat", "type": "call", "template": "parseFloat({0})" },
  { "id": "Bit.and", "type": "call", "template": "({0} & {1})" },
  { "id": "Bit.or", "type": "call", "template": "({0} | {1})" },
  { "id": "Bit.xor", "type": "call", "template": "({0} ^ {1})" },
  { "id": "Bit.not", "type": "call", "template": "(~{0})" },
  { "id": "Bit.shiftL", "type": "call", "template": "({0} << {1})" },
  { "id": "Bit.shiftR", "type": "call", "template": "({0} >> {1})" },
  { "id": "Regex.match", "type": "call", "template": "Rgx.match({0}, {1}, {2})" },
  { "id": "Regex.replace", "type": "call", "template": "Rgx.replace({0}, {1}, {2}, {3})" },
  { "id": "Regex.test", "type": "call", "template": "Rgx.test({0}, {1}, {2})" },
  { "id": "JSOL.hasKey", "type": "call", "template": "Object.prototype.hasOwnProperty.call({0}, {1})" },
  { "id": "JSOL.len", "type": "call", "template": "{0}.length" },
  { "id": "JSOL.count", "type": "call", "template": "{0}.length" },
  { "id": "JSOL.set", "type": "call", "template": "/* mem-op */" },
  { "id": "JSOL.unset", "type": "call", "template": "/* mem-op */" },
  { "id": "JSOL.JS", "type": "block", "template": "unwrap" },
  { "id": "JSOL.PHP", "type": "block", "template": "strip" },
  { "id": "JSOL.use", "type": "regex", "search": "JSOL\\.use\\s*\\([^)]+\\)\\s*;?", "template": "" },
  { "id": "JSOL.range", "type": "range", "template": "" },
  { "id": "Math.PI", "type": "replace", "template": "Math.PI" },
  { "id": "isNaN", "type": "call", "template": "isNaN({0})" },
  { "id": "Math.", "type": "replace", "template": "Math." }
]