{
  "version": "0.2.97",
  "target": "js",
  "meta": {
    "templates": {
      "shadow_map_ref": "$mJSOL_{root}_ok"
    }
  },
  "transforms": {
    "TRUNC_CHECKED": {
      "template": "Math.trunc({1})"
    },
    "implicit": {
      "template": "Number({1})"
    },
    "Cast.toStr": {
      "template": "Cast.toStr({1})"
    },
    "Cast.toInt": {
      "template": "Cast.toInt({1})"
    },
    "Cast.toFloat": {
      "template": "Cast.toFloat({1})"
    }
  },
  "operations": {
    "Str.concat": { "template": "Str[\"concat\"]({*})" },
    "Str.sub": { "template": "Str[\"sub\"]({0}, {1}, {2})" },
    "Str.len": { "template": "Str[\"len\"]({0})" },
    "Str.indexOf": { "template": "Str[\"indexOf\"]({0}, {1})" },
    "Str.char": { "template": "Str[\"char\"]({0}, {1})" },
    "Str.fromChar": { "template": "Str[\"fromChar\"]({0})" },
    "Str.upper": { "template": "{0}.toUpperCase()" },
    "Str.lower": { "template": "{0}.toLowerCase()" },
    "Str.trim": { "template": "{0}.trim()" },
    "Str.split": { "template": "Str[\"split\"]({0}, {1})" },
    "Str.contains": { "template": "Str[\"contains\"]({0}, {1})" },
    "Str.startsWith": { "template": "{0}.startsWith({1})" },
    "Str.endsWith": { "template": "{0}.endsWith({1})" },
    "Str.replaceAll": { "template": "{0}.split({1}).join({2})" },
    "Str.replace": { "template": "Str[\"replace\"]({0}, {1}, {2})" },
    "Str.same": { "template": "Str[\"same\"]({0}, {1}, {2})" },
    "Str.padStart": { "template": "Str[\"padStart\"]({0}, {1}, {2})" },
    "Str.padEnd": { "template": "Str[\"padEnd\"]({0}, {1}, {2})" },
    "Str.repeat": { "template": "{0}.repeat({1})" },
    "Str.eq": { "template": "({0} === {1})" },
    "Str.neq": { "template": "({0} !== {1})" },
    "Arr.len": { "template": "{0}.length" },
    "Arr.count": { "template": "{0}.length" },
    "Arr.push": { "template": "{0}.push({1})" },
    "Arr.pop": { "template": "Arr[\"pop\"]({0})" },
    "Arr.shift": { "template": "Arr[\"shift\"]({0})" },
    "Arr.unshift": { "template": "{0}.unshift({1})" },
    "Arr.slice": { "template": "{0}.slice({1}, {2})" },
    "Arr.indexOf": { "template": "Arr[\"indexOf\"]({0}, {1})" },
    "Arr.join": { "template": "{0}.join({1})" },
    "Arr.contains": { "template": "{0}.includes({1})" },
    "Arr.sort": { "template": "Arr[\"sort\"]({0}, {1})" },
    "Map.has": { "template": "Object.prototype.hasOwnProperty.call({0}, {1})" },
    "Map.keys": { "template": "Object.keys({0})" },
    "Map.values": { "template": "Object.values({0})" },
    "Map.count": { "template": "Object.keys({0}).length" },
    "Map.create": { "template": "JSOL.dict({*})" },
    "Map.get": { "template": "Map[\"get\"]({0}, {1})" },
    "Bool.and": { "template": "Bool[\"and\"]({*})" },
    "Bool.or": { "template": "Bool[\"or\"]({*})" },
    "Bool.xor": { "template": "Bool[\"xor\"]({*})" },
    "Bool.not": { "template": "(!{0})" },
    "Bool.eq": { "template": "Bool[\"eq\"]({*})" },
    "Bool.neq": { "template": "Bool[\"neq\"]({*})" },
    "Cast.toInt": { "template": "Cast[\"toInt\"]({0})" },
    "Cast.toStr": { "template": "Cast[\"toStr\"]({0})" },
    "Cast.toFloat": { "template": "Cast[\"toFloat\"]({0})" },
    "Bit.and": { "template": "({0} & {1})" },
    "Bit.or": { "template": "({0} | {1})" },
    "Bit.xor": { "template": "({0} ^ {1})" },
    "Bit.not": { "template": "(~{0})" },
    "Bit.shiftL": { "template": "({0} << {1})" },
    "Bit.shiftR": { "template": "({0} >> {1})" },
    "Regex.match": { "template": "Rgx.match({0}, {1}, {2})" },
    "Regex.replace": { "template": "Rgx.replace({0}, {1}, {2}, {3})" },
    "Regex.test": { "template": "Rgx.test({0}, {1}, {2})" },
    "JSOL.hasKey": { "template": "Object.prototype.hasOwnProperty.call({0}, {1})" },
    "JSOL.len": { "template": "{0}.length" },
    "JSOL.count": { "template": "{0}.length" },
    "JSOL.set": { "template": "/* mem-op */" },
    "JSOL.unset": { "template": "/* mem-op */" },
    "JSOL.ok": { "template": "JSOL[\"ok\"]()" },
    "JSOL.resetShadow": { "template": "JSOL[\"resetShadow\"]()" },
    "JSOL.JS": { "type": "block", "template": "unwrap" },
    "JSOL.PHP": { "type": "block", "template": "strip" },
    "JSOL.PY": { "type": "block", "template": "strip" },
    "JSOL.use": { "type": "regex", "search": "JSOL\\.use\\s*\\([^)]+\\)\\s*;?", "template": "" },
    "JSOL.range": { "type": "range", "template": "" },
    "isNaN": { "template": "Number.isNaN({0})" },
    "Math.abs": { "template": "Math[\"abs\"]({0})" },
    "Math.pow": { "template": "Math[\"pow\"]({0}, {1})" },
    "Math.sqrt": { "template": "Math[\"sqrt\"]({0})" },
    "Math.cbrt": { "template": "Math[\"cbrt\"]({0})" },
    "Math.floor": { "template": "Math[\"floor\"]({0})" },
    "Math.ceil": { "template": "Math[\"ceil\"]({0})" },
    "Math.trunc": { "template": "Math[\"trunc\"]({0})" },
    "Math.sum": { "template": "Math[\"sum\"]({*})" },
    "Math.sub": { "template": "Math[\"sub\"]({*})" },
    "Math.mul": { "template": "Math[\"mul\"]({*})" },
    "Math.div": { "template": "Math[\"div\"]({*})" },
    "Math.idiv": { "template": "Math[\"idiv\"]({0}, {1})" },
    "Math.modX": { "template": "Math[\"modX\"]({0}, {1})" },
    "Math.roundX": { "template": "Math[\"roundX\"]({0})" },

"Math.logX": { "template": "Math[\"logX\"]({0}, {1})" },
    "Math.ln": { "template": "Math[\"ln\"]({0})" },
    "Math.min": { "template": "Math[\"min\"]({*})" },
    "Math.max": { "template": "Math[\"max\"]({*})" },
    "Cast.toBool": { "template": "Cast[\"toBool\"]({0})" },
    "Math.E": { "type": "replace", "template": "Math.E" },
    "Math.PI": { "type": "replace", "template": "Math.PI" },

    "Math.sin": { "template": "Math[\"sin\"]({0})" },
    "Math.cos": { "template": "Math[\"cos\"]({0})" },
    "Math.tan": { "template": "Math[\"tan\"]({0})" },
    "Math.asin": { "template": "Math[\"asin\"]({0})" },
    "Math.acos": { "template": "Math[\"acos\"]({0})" },
    "Math.atan": { "template": "Math[\"atan\"]({0})" },
    "Math.atan2": { "template": "Math[\"atan2\"]({0}, {1})" },
    "Math.eq": { "template": "({0} === {1})" },
    "Math.neq": { "template": "({0} !== {1})" },
    "Math.gt": { "template": "({0} > {1})" },
    "Math.lt": { "template": "({0} < {1})" },
    "Math.gte": { "template": "({0} >= {1})" },
    "Math.lte": { "template": "({0} <= {1})" }
  }
}