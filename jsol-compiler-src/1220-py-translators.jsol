// @JSOL v0.2.97 - Python Translators & Sanitizers
const $aTranslateCommentTokensToPython = function($aTokens) {
    let $aResult = [];
    for (let $i = 0; $i < Arr.len($aTokens); $i = $i + 1) {
        const $mToken = $aTokens[$i];
        const $saKey = $mToken["key"];
        const $saVal = $mToken["value"];

        if (Str.sub($saVal, 0, 2) === "//") {
            const $saRest = Str.sub($saVal, 2, Str.len($saVal) - 2);
            Arr.push($aResult, Map.create("key", $saKey, "value", "#" + "" + $saRest));

        } else if (Str.sub($saVal, 0, 2) === "/*") {
            let $saInner = Str.sub($saVal, 2, Str.len($saVal) - 2);
            if (Str.sub($saInner, Str.len($saInner) - 2, 2) === "*/") {
                $saInner = Str.sub($saInner, 0, Str.len($saInner) - 2);
            }
            const $saConverted = "#" + "" + Str.replace($saInner, "\n", "\n#");
            Arr.push($aResult, Map.create("key", $saKey, "value", $saConverted));

        } else {
            Arr.push($aResult, Map.create("key", $saKey, "value", $saVal));
        }
    }
    return $aResult;
};

const $saTranslateOperators = function($saExpr) {
    JSOL.use($bIsIdentChar, $mReadWord);
    let $saResult = "";
    let $i = 0;
    const $iLen = Str.len($saExpr);

    while ($i < $iLen) {
        const $saCh = Str.sub($saExpr, $i, 1);
        const $bAtBoundary = ($i === 0) || ($bIsIdentChar(Str.sub($saExpr, $i - 1, 1)) === false);

        if ($bAtBoundary === true && $bIsIdentChar($saCh) === true) {
            const $mWord = $mReadWord($saExpr, $i);
            const $saWordStr = $mWord["word"];

            if ($saWordStr === "true") { $saResult = $saResult + "" + "True"; $i = $mWord["end"]; } 
            else if ($saWordStr === "false") { $saResult = $saResult + "" + "False"; $i = $mWord["end"]; } 
            else if ($saWordStr === "null") { $saResult = $saResult + "" + "None"; $i = $mWord["end"]; } 
            else { $saResult = $saResult + "" + $saWordStr; $i = $mWord["end"]; }
        } else {
            const $saTwo = Str.sub($saExpr, $i, 2);
            const $saThree = Str.sub($saExpr, $i, 3);

            if ($saThree === "===") { $saResult = $saResult + "" + "=="; $i = $i + 3; } 
            else if ($saThree === "!==") { $saResult = $saResult + "" + "!="; $i = $i + 3; } 
            else if ($saTwo === "&&") { $saResult = $saResult + "" + "and"; $i = $i + 2; } 
            else if ($saTwo === "||") { $saResult = $saResult + "" + "or"; $i = $i + 2; } 
            else if ($saTwo === "!=") { $saResult = $saResult + "" + "!="; $i = $i + 2; } 
            else if (Str.sub($saExpr, $i, 1) === "!") { $saResult = $saResult + "" + "not "; $i = $i + 1; } 
            else { $saResult = $saResult + "" + $saCh; $i = $i + 1; }
        }
    }
    return $saResult;
};

const $saSanitizePythonIdentifiers = function($saMaskedCode) {
    JSOL.use($bIsIdentChar);
    const $aPyKeywords = [
        "False", "None", "True", "and", "as", "assert", "async", "await", "break", "class", 
        "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", 
        "if", "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return",
        "try", "while", "with", "yield"
    ];
    const $aPyBuiltins = [
        "str", "int", "float", "bool", "list", "dict", "set", "tuple", "type", "id", "len", 
        "map", "filter", "sum", "min", "max", "sorted", "input", "print", "format", "object", 
        "super", "next", "iter", "hash", "range", "repr", "slice", "zip", "vars", "dir", "open", 
        "eval", "exec", "abs", "all", "any", "bin", "chr", "ord", "hex", "oct", "pow", "round", 
        "property", "staticmethod", "classmethod"
    ];

    let $saResult = "";
    const $iLen = Str.len($saMaskedCode);
    let $i = 0;
    while ($i < $iLen) {
        const $saCh = Str.sub($saMaskedCode, $i, 1);
        if ($saCh === "$") {
            let $iJ = $i + 1;
            while ($iJ < $iLen && $bIsIdentChar(Str.sub($saMaskedCode, $iJ, 1)) === true) { $iJ = $iJ + 1; }
            let $saName = Str.sub($saMaskedCode, $i + 1, $iJ - $i - 1);
            if (Arr.indexOf($aPyKeywords, $saName) !== -1 || Arr.indexOf($aPyBuiltins, $saName) !== -1) {
                $saName = $saName + "_";
            }
            $saResult = $saResult + "" + $saName;
            $i = $iJ;
        } else {
            $saResult = $saResult + "" + $saCh;
            $i = $i + 1;
        }
    }
    return $saResult;
};