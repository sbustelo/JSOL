// @JSOL v0.2.97 - PHP Syntax Fixes (Isolated String Manipulations)
const $saPhp_StripDeclarations = function($saCode) {
	let $saRes = $saCode;
	const $aPrefixes = ["\n", "\r\n", "\t", " ", "("];
	for (let $iP = 0; $iP < 5; $iP = $iP + 1) {
		$saRes = Str.replace($saRes, $aPrefixes[$iP] + "const ", $aPrefixes[$iP]);
		$saRes = Str.replace($saRes, $aPrefixes[$iP] + "let ", $aPrefixes[$iP]);
		$saRes = Str.replace($saRes, $aPrefixes[$iP] + "var ", $aPrefixes[$iP]);
	}
	if (Str.indexOf($saRes, "const ") === 0) { $saRes = Str.sub($saRes, 6, Str.len($saRes) - 6); }
	if (Str.indexOf($saRes, "let ") === 0) { $saRes = Str.sub($saRes, 4, Str.len($saRes) - 4); }
	if (Str.indexOf($saRes, "var ") === 0) { $saRes = Str.sub($saRes, 4, Str.len($saRes) - 4); }
	return $saRes;
};

const $saPhp_FixStringConcat = function($saCode) {
	let $saRes = $saCode;
	$saRes = Regex.replace('(__JSOL_(TOKEN|STR|COM)_\\d+__)\\s*\\+', '$1 .', $saRes, 'g');
	$saRes = Regex.replace('\\+\\s*(__JSOL_(TOKEN|STR|COM)_\\d+__)', '. $1', $saRes, 'g');
	$saRes = Regex.replace('(\\$s[A-Za-z0-9_]*)\\s*\\+', '$1 .', $saRes, 'g');
	$saRes = Regex.replace('\\+\\s*(\\$s[A-Za-z0-9_]*)', '. $1', $saRes, 'g');
	return $saRes;
};

const $saPhp_FixUseReferences = function($saCode) {
	let $saResult = $saCode;
	let $bFixUse = true;
	let $iUseOffset = 0;

	while ($bFixUse === true) {
		const $iSearchLen = Str.len($saResult) - $iUseOffset;
		if ($iSearchLen <= 0) { $bFixUse = false; continue; }
		
		const $saSearchArea = Str.sub($saResult, $iUseOffset, $iSearchLen);
		const $iUseRel = Str.indexOf($saSearchArea, "use (");
		if ($iUseRel === -1) { $bFixUse = false; continue; }

		const $iStart = $iUseOffset + $iUseRel + 5;
		const $saTail = Str.sub($saResult, $iStart, Str.len($saResult) - $iStart);
		const $iEndRel = Str.indexOf($saTail, ")");
		const $iEnd = $iStart + $iEndRel;

		const $saArgs = Str.sub($saResult, $iStart, $iEnd - $iStart);
		let $saRefArgs = Regex.replace("\\$", "&$", $saArgs, "g");
		$saRefArgs = Regex.replace("&&\\$", "&$", $saRefArgs, "g");

		const $saBefore = Str.sub($saResult, 0, $iStart);
		const $saAfter = Str.sub($saResult, $iEnd, Str.len($saResult) - $iEnd);

		$saResult = $saBefore + "" + $saRefArgs + "" + $saAfter;
		$iUseOffset = $iStart + Str.len($saRefArgs) + 1; 
	}
	return $saResult;
};