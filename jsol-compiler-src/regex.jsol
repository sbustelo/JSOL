// @JSOL v0.2.90 - Pure JSOL Regex Engine (Thompson VM)

const $parseAtom = function($pat, $i, $n, $gc, $fns) {
    const $c = Str.sub($pat, $i, 1);
    if ($c === "(") {
        $i = $i + 1;
        $gc = $gc + 1;
        const $idx = $gc;
        const $pAltFn = $fns["parseAlt"];
        let $r = $pAltFn($pat, $i, $n, $gc, $fns);
        const $body = $r["node"];
        $i = $r["i"];
        $gc = $r["groupCount"];
        $i = $i + 1;
        return Map.create("node", Map.create("type", "group", "index", $idx, "body", $body), "i", $i, "groupCount", $gc);
    }
    if ($c === "[") {
        $i = $i + 1;
        let $negate = false;
        if ($i < $n && Str.sub($pat, $i, 1) === "^") {
            $negate = true;
            $i = $i + 1;
        }
        let $ranges = [];
        let $singles = [];
        let $first = true;
        while ($i < $n && (Str.sub($pat, $i, 1) !== "]" || $first)) {
            $first = false;
            let $ch = Str.sub($pat, $i, 1);
            let $isShorthand = false;
            if ($ch === "\\") {
                $i = $i + 1;
                const $e = Str.sub($pat, $i, 1);
                if ($e === "d") {
                    const $r09 = ["0", "9"]; Arr.push($ranges, $r09);
                    $isShorthand = true;
                    $i = $i + 1;
                } else if ($e === "w") {
                    const $raz = ["a", "z"]; Arr.push($ranges, $raz);
                    const $rAZ = ["A", "Z"]; Arr.push($ranges, $rAZ);
                    const $r09w = ["0", "9"]; Arr.push($ranges, $r09w);
                    Arr.push($singles, "_");
                    $isShorthand = true;
                    $i = $i + 1;
                } else if ($e === "s") {
                    Arr.push($singles, " "); Arr.push($singles, "\t"); Arr.push($singles, "\n"); Arr.push($singles, "\r");
                    $isShorthand = true;
                    $i = $i + 1;
                } else {
                    $ch = $e;
                    $i = $i + 1;
                }
            } else {
                $i = $i + 1;
            }
            if ($isShorthand === true) { continue; }
            if ($i < $n && Str.sub($pat, $i, 1) === "-" && $i + 1 < $n && Str.sub($pat, $i + 1, 1) !== "]") {
                $i = $i + 1;
                let $ch2 = Str.sub($pat, $i, 1);
                if ($ch2 === "\\") {
                    $i = $i + 1;
                    $ch2 = Str.sub($pat, $i, 1);
                    $i = $i + 1;
                } else {
                    $i = $i + 1;
                }
                const $rng = [$ch, $ch2];
                Arr.push($ranges, $rng);
            } else {
                Arr.push($singles, $ch);
            }
        }
        $i = $i + 1;
        return Map.create("node", Map.create("type", "class", "negate", $negate, "ranges", $ranges, "singles", $singles), "i", $i, "groupCount", $gc);
    }
    if ($c === ".") {
        $i = $i + 1;
        return Map.create("node", Map.create("type", "any"), "i", $i, "groupCount", $gc);
    }
    if ($c === "^") {
        $i = $i + 1;
        return Map.create("node", Map.create("type", "anchorStart"), "i", $i, "groupCount", $gc);
    }
    if ($c === "$") {
        $i = $i + 1;
        return Map.create("node", Map.create("type", "anchorEnd"), "i", $i, "groupCount", $gc);
    }
    if ($c === "\\") {
        $i = $i + 1;
        const $e = Str.sub($pat, $i, 1);
        $i = $i + 1;
        if ($e === "d") { const $rd = [["0", "9"]]; return Map.create("node", Map.create("type", "class", "negate", false, "ranges", $rd, "singles", []), "i", $i, "groupCount", $gc); }
        if ($e === "w") { const $rw = [["a", "z"], ["A", "Z"], ["0", "9"]]; const $sw = ["_"]; return Map.create("node", Map.create("type", "class", "negate", false, "ranges", $rw, "singles", $sw), "i", $i, "groupCount", $gc); }
        if ($e === "s") { const $ss = [" ", "\t", "\n", "\r"]; return Map.create("node", Map.create("type", "class", "negate", false, "ranges", [], "singles", $ss), "i", $i, "groupCount", $gc); }
        return Map.create("node", Map.create("type", "char", "value", $e), "i", $i, "groupCount", $gc);
    }
    $i = $i + 1;
    return Map.create("node", Map.create("type", "char", "value", $c), "i", $i, "groupCount", $gc);
};

const $parseQuantified = function($pat, $i, $n, $gc, $fns) {
    const $paFn = $fns["parseAtom"];
    let $r = $paFn($pat, $i, $n, $gc, $fns);
    let $atom = $r["node"];
    $i = $r["i"];
    $gc = $r["groupCount"];

    while ($i < $n) {
        const $c = Str.sub($pat, $i, 1);
        if ($c === "*") {
            $i = $i + 1;
            let $lazy = false;
            if ($i < $n && Str.sub($pat, $i, 1) === "?") { $lazy = true; $i = $i + 1; }
            $atom = Map.create("type", "rep", "min", 0, "max", 999999, "lazy", $lazy, "body", $atom);
        } else if ($c === "+") {
            $i = $i + 1;
            let $lazy = false;
            if ($i < $n && Str.sub($pat, $i, 1) === "?") { $lazy = true; $i = $i + 1; }
            $atom = Map.create("type", "rep", "min", 1, "max", 999999, "lazy", $lazy, "body", $atom);
        } else if ($c === "?") {
            $i = $i + 1;
            let $lazy = false;
            if ($i < $n && Str.sub($pat, $i, 1) === "?") { $lazy = true; $i = $i + 1; }
            $atom = Map.create("type", "rep", "min", 0, "max", 1, "lazy", $lazy, "body", $atom);
        } else {
            break;
        }
    }
    return Map.create("node", $atom, "i", $i, "groupCount", $gc);
};

const $parseConcat = function($pat, $i, $n, $gc, $fns) {
    let $parts = [];
    const $pqFn = $fns["parseQuantified"];
    while ($i < $n && Str.sub($pat, $i, 1) !== "|" && Str.sub($pat, $i, 1) !== ")") {
        let $r = $pqFn($pat, $i, $n, $gc, $fns);
        Arr.push($parts, $r["node"]);
        $i = $r["i"];
        $gc = $r["groupCount"];
    }
    return Map.create("node", Map.create("type", "concat", "parts", $parts), "i", $i, "groupCount", $gc);
};

const $parseAlt = function($pat, $i, $n, $gc, $fns) {
    let $options = [];
    const $pcFn = $fns["parseConcat"];
    let $r1 = $pcFn($pat, $i, $n, $gc, $fns);
    Arr.push($options, $r1["node"]);
    $i = $r1["i"];
    $gc = $r1["groupCount"];

    while ($i < $n && Str.sub($pat, $i, 1) === "|") {
        $i = $i + 1;
        let $r2 = $pcFn($pat, $i, $n, $gc, $fns);
        Arr.push($options, $r2["node"]);
        $i = $r2["i"];
        $gc = $r2["groupCount"];
    }
    if (Arr.count($options) === 1) { return Map.create("node", $options[0], "i", $i, "groupCount", $gc); }
    return Map.create("node", Map.create("type", "alt", "options", $options), "i", $i, "groupCount", $gc);
};

const $parsePattern = function($pat) {
    JSOL.use($parseAlt, $parseConcat, $parseQuantified, $parseAtom);
    const $fns = Map.create(
        "parseAlt", $parseAlt,
        "parseConcat", $parseConcat,
        "parseQuantified", $parseQuantified,
        "parseAtom", $parseAtom
    );
    const $n = Str.len($pat);
    const $r = $parseAlt($pat, 0, $n, 0, $fns);
    return Map.create("tree", $r["node"], "groupCount", $r["groupCount"]);
};

const $gen = function($n, $prog, $selfFn) {
    const $type = $n["type"];
    if ($type === "concat") {
        const $parts = $n["parts"];
        const $pCount = Arr.count($parts);
        for (let $p = 0; $p < $pCount; $p = $p + 1) { 
            $prog = $selfFn($parts[$p], $prog, $selfFn); 
        }
    } else if ($type === "alt") {
        const $options = $n["options"];
        const $oCount = Arr.count($options);
        let $jmpEnds = [];
        for (let $idx = 0; $idx < $oCount; $idx = $idx + 1) {
            if ($idx < $oCount - 1) {
                const $splitPc = Arr.count($prog);
                Arr.push($prog, Map.create("op", "SPLIT", "x", 0, "y", 0));
                const $x = Arr.count($prog);
                $prog = $selfFn($options[$idx], $prog, $selfFn);
                const $jmpPc = Arr.count($prog);
                Arr.push($prog, Map.create("op", "JMP", "to", 0));
                Arr.push($jmpEnds, $jmpPc);
                $prog[$splitPc]["x"] = $x;
                $prog[$splitPc]["y"] = Arr.count($prog);
            } else {
                $prog = $selfFn($options[$idx], $prog, $selfFn);
            }
        }
        const $jCount = Arr.count($jmpEnds);
        for (let $j = 0; $j < $jCount; $j = $j + 1) {
            $prog[$jmpEnds[$j]]["to"] = Arr.count($prog);
        }
    } else if ($type === "rep") {
        const $min = $n["min"];
        const $max = $n["max"];
        const $lazy = $n["lazy"];
        for (let $c = 0; $c < $min; $c = $c + 1) { 
            $prog = $selfFn($n["body"], $prog, $selfFn); 
        }
        if ($max === 999999) {
            const $splitPc = Arr.count($prog);
            Arr.push($prog, Map.create("op", "SPLIT", "x", 0, "y", 0));
            const $bodyStart = Arr.count($prog);
            $prog = $selfFn($n["body"], $prog, $selfFn);
            Arr.push($prog, Map.create("op", "JMP", "to", $splitPc));
            if ($lazy === true) {
                $prog[$splitPc]["x"] = Arr.count($prog);
                $prog[$splitPc]["y"] = $bodyStart;
            } else {
                $prog[$splitPc]["x"] = $bodyStart;
                $prog[$splitPc]["y"] = Arr.count($prog);
            }
        } else {
            const $optional = $max - $min;
            for (let $c = 0; $c < $optional; $c = $c + 1) {
                const $splitPc = Arr.count($prog);
                Arr.push($prog, Map.create("op", "SPLIT", "x", 0, "y", 0));
                const $bodyStart = Arr.count($prog);
                $prog = $selfFn($n["body"], $prog, $selfFn);
                if ($lazy === true) {
                    $prog[$splitPc]["x"] = Arr.count($prog);
                    $prog[$splitPc]["y"] = $bodyStart;
                } else {
                    $prog[$splitPc]["x"] = $bodyStart;
                    $prog[$splitPc]["y"] = Arr.count($prog);
                }
            }
        }
    } else if ($type === "group") {
        Arr.push($prog, Map.create("op", "SAVE", "slot", $n["index"] * 2));
        $prog = $selfFn($n["body"], $prog, $selfFn);
        Arr.push($prog, Map.create("op", "SAVE", "slot", $n["index"] * 2 + 1));
    } else if ($type === "char") {
        Arr.push($prog, Map.create("op", "CHAR", "value", $n["value"]));
    } else if ($type === "any") {
        Arr.push($prog, Map.create("op", "ANY"));
    } else if ($type === "class") {
        Arr.push($prog, Map.create("op", "CLASS", "negate", $n["negate"], "ranges", $n["ranges"], "singles", $n["singles"]));
    } else if ($type === "anchorStart") {
        Arr.push($prog, Map.create("op", "BOL"));
    } else if ($type === "anchorEnd") {
        Arr.push($prog, Map.create("op", "EOL"));
    }
    return $prog;
};

const $compileRegex = function($node, $groupCount) {
    JSOL.use($gen);
    let $prog = [];
    Arr.push($prog, Map.create("op", "SAVE", "slot", 0));
    $prog = $gen($node, $prog, $gen);
    Arr.push($prog, Map.create("op", "SAVE", "slot", 1));
    Arr.push($prog, Map.create("op", "MATCH"));
    return $prog;
};

const $toLower = function($ch) {
    const $code = Str.char($ch, 0);
    if ($code >= 65 && $code <= 90) { return Str.fromChar($code + 32); }
    return $ch;
};

const $charMatches = function($instr, $ch, $ci) {
    JSOL.use($toLower);
    let $inSet = false;
    const $chComp = $ci === true ? $toLower($ch) : $ch;
    const $cCode = Str.char($chComp, 0);

    const $singles = $instr["singles"];
    const $sCount = Arr.count($singles);
    for (let $i = 0; $i < $sCount; $i = $i + 1) {
        const $s = $singles[$i];
        const $sComp = $ci === true ? $toLower($s) : $s;
        if ($sComp === $chComp) { $inSet = true; }
    }

    const $ranges = $instr["ranges"];
    const $rCount = Arr.count($ranges);
    for (let $i = 0; $i < $rCount; $i = $i + 1) {
        const $r = $ranges[$i];
        const $a = $ci === true ? $toLower($r[0]) : $r[0];
        const $b = $ci === true ? $toLower($r[1]) : $r[1];
        const $aCode = Str.char($a, 0);
        const $bCode = Str.char($b, 0);
        if ($cCode >= $aCode && $cCode <= $bCode) { $inSet = true; }
    }

    if ($instr["negate"] === true) { return !$inSet; }
    return $inSet;
};

const $runRegex = function($prog, $str, $ci, $groupCount, $startSp) {
    JSOL.use($charMatches, $toLower);
    const $n = Str.len($str);
    let $pc = 0;
    let $sp = $startSp;
    let $saves = [];
    const $savesLen = ($groupCount + 1) * 2;
    for (let $i = 0; $i < $savesLen; $i = $i + 1) { Arr.push($saves, -1); }

    const $stack = [];
    let $stackPtr = 0;

    let $running = true;
    let $matched = false;

    while ($running === true) {
        const $instr = $prog[$pc];
        let $ok = true;
        const $op = $instr["op"];

        if ($op === "CHAR") {
            if ($sp < $n) {
                const $ch = Str.sub($str, $sp, 1);
                const $val = $instr["value"];
                const $match = $ci === true ? ($toLower($ch) === $toLower($val)) : ($ch === $val);
                if ($match === true) { $sp = $sp + 1; $pc = $pc + 1; } else { $ok = false; }
            } else { $ok = false; }
        } else if ($op === "ANY") {
            if ($sp < $n) { $sp = $sp + 1; $pc = $pc + 1; } else { $ok = false; }
        } else if ($op === "CLASS") {
            if ($sp < $n) {
                const $ch = Str.sub($str, $sp, 1);
                if ($charMatches($instr, $ch, $ci) === true) { $sp = $sp + 1; $pc = $pc + 1; } else { $ok = false; }
            } else { $ok = false; }
        } else if ($op === "BOL") {
            if ($sp === 0) { $pc = $pc + 1; } else { $ok = false; }
        } else if ($op === "EOL") {
            if ($sp === $n) { $pc = $pc + 1; } else { $ok = false; }
        } else if ($op === "JMP") {
            $pc = $instr["to"];
        } else if ($op === "SPLIT") {
            const $savesCopy = [];
            for (let $i = 0; $i < $savesLen; $i = $i + 1) { Arr.push($savesCopy, $saves[$i]); }
            const $frame = Map.create("pc", $instr["y"], "sp", $sp, "saves", $savesCopy);
            if ($stackPtr < Arr.count($stack)) { $stack[$stackPtr] = $frame; } else { Arr.push($stack, $frame); }
            $stackPtr = $stackPtr + 1;
            
            $pc = $instr["x"];
        } else if ($op === "SAVE") {
            $saves[$instr["slot"]] = $sp;
            $pc = $pc + 1;
        } else if ($op === "MATCH") {
            $matched = true;
            $running = false;
        } else {
            $ok = false;
        }

        if ($running === true && $ok === false) {
            if ($stackPtr === 0) { 
                $running = false; 
            } else {
                $stackPtr = $stackPtr - 1;
                const $f = $stack[$stackPtr];
                $pc = $f["pc"];
                $sp = $f["sp"];
                $saves = $f["saves"];
            }
        }
    }

    return Map.create("matched", $matched, "saves", $saves);
};

const $regexMatch = function($patternStr, $str, $flags) {
    JSOL.use($parsePattern, $compileRegex, $runRegex);
    let $ci = false;
    let $global = false;
    if (Str.indexOf($flags, "i") !== -1) { $ci = true; }
    if (Str.indexOf($flags, "g") !== -1) { $global = true; }

    const $parsed = $parsePattern($patternStr);
    const $prog = $compileRegex($parsed["tree"], $parsed["groupCount"]);
    const $groupCount = $parsed["groupCount"];

    const $n = Str.len($str);
    for (let $start = 0; $start <= $n; $start = $start + 1) {
        const $r = $runRegex($prog, $str, $ci, $groupCount, $start);
        if ($r["matched"] === true) {
            let $groups = [];
            for (let $g = 0; $g <= $groupCount; $g = $g + 1) {
                const $s = $r["saves"][$g * 2];
                const $e = $r["saves"][$g * 2 + 1];
                if ($s >= 0 && $e >= 0) {
                    const $subG = Str.sub($str, $s, $e - $s);
                    Arr.push($groups, $subG);
                } else {
                    Arr.push($groups, null);
                }
            }
            return Map.create("matched", true, "groups", $groups, "index", $start, "length", $r["saves"][1] - $r["saves"][0]);
        }
    }
    return Map.create("matched", false, "groups", [], "index", -1, "length", 0);
};

const $regexReplace = function($patternStr, $replacementStr, $str, $flags) {
    JSOL.use($parsePattern, $compileRegex, $runRegex);
    let $ci = false;
    let $global = false;
    if (Str.indexOf($flags, "i") !== -1) { $ci = true; }
    if (Str.indexOf($flags, "g") !== -1) { $global = true; }

    const $parsed = $parsePattern($patternStr);
    const $prog = $compileRegex($parsed["tree"], $parsed["groupCount"]);
    const $groupCount = $parsed["groupCount"];

    let $result = "";
    let $i = 0;
    const $n = Str.len($str);

    while ($i <= $n) {
        let $matchFound = false;
        let $r = null;
        let $matchIndex = $i;
        
        for (let $start = $i; $start <= $n; $start = $start + 1) {
            $r = $runRegex($prog, $str, $ci, $groupCount, $start);
            if ($r["matched"] === true) {
                $matchFound = true;
                $matchIndex = $start;
                break;
            }
        }

        if ($matchFound === true) {
            const $matchStart = $r["saves"][0];
            const $matchEnd = $r["saves"][1];

            const $subA = Str.sub($str, $i, $matchStart - $i);
            $result = $result + "" + $subA;

            let $repResult = "";
            const $repLen = Str.len($replacementStr);
            for (let $k = 0; $k < $repLen; $k = $k + 1) {
                const $c = Str.sub($replacementStr, $k, 1);
                if ($c === "$" && $k + 1 < $repLen) {
                    const $nextC = Str.sub($replacementStr, $k + 1, 1);
                    const $code = Str.char($nextC, 0);
                    if ($code >= 48 && $code <= 57) { 
                        const $gIdx = $code - 48;
                        if ($gIdx <= $groupCount) {
                            const $gs = $r["saves"][$gIdx * 2];
                            const $ge = $r["saves"][$gIdx * 2 + 1];
                            if ($gs >= 0 && $ge >= 0) {
                                const $subB = Str.sub($str, $gs, $ge - $gs);
                                $repResult = $repResult + "" + $subB;
                            }
                        }
                        $k = $k + 1;
                    } else {
                        $repResult = $repResult + "" + $c;
                    }
                } else {
                    $repResult = $repResult + "" + $c;
                }
            }

            $result = $result + "" + $repResult;
            
            if ($matchEnd === $matchIndex) {
                if ($matchIndex < $n) {
                    const $subC = Str.sub($str, $matchIndex, 1);
                    $result = $result + "" + $subC;
                }
                $i = $matchIndex + 1;
            } else {
                $i = $matchEnd;
            }

            if ($global === false) {
                const $subD = Str.sub($str, $i, $n - $i);
                $result = $result + "" + $subD;
                break;
            }
        } else {
            const $subE = Str.sub($str, $i, $n - $i);
            $result = $result + "" + $subE;
            break;
        }
    }

    return $result;
};