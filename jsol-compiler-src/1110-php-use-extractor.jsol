// @JSOL v0.2.97 - PHP Use Clause Extractor (Flat Cyclomatic Complexity)
const $bPhp_IsIdentChar = function ($saCh) {
	if ($saCh === "$") { return true; }
	if ($saCh >= "a" && $saCh <= "z") { return true; }
	if ($saCh >= "A" && $saCh <= "Z") { return true; }
	if ($saCh >= "0" && $saCh <= "9") { return true; }
	return false;
};

const $mPhp_ReadWord = function ($saCode, $iStart) {
	JSOL.use($bPhp_IsIdentChar);
	const $iLen = Str.len($saCode);
	let $i = $iStart;
	while ($i < $iLen && $bPhp_IsIdentChar(Str.sub($saCode, $i, 1))) {
		$i = $i + 1;
	}
	return Map.create("word", Str.sub($saCode, $iStart, $i - $iStart), "end", $i);
};

const $aPhp_ExtractVars = function($saText) {
	JSOL.use($mPhp_ReadWord);
	let $aVars = [];
	let $i = 0;
	const $iLen = Str.len($saText);
	while ($i < $iLen) {
		if (Str.sub($saText, $i, 1) === "$") {
			const $mWord = $mPhp_ReadWord($saText, $i);
			if ($mWord["word"] !== '$_') {
				Arr.push($aVars, $mWord["word"]);
			}
			$i = $mWord["end"];
		} else {
			$i = $i + 1;
		}
	}
	return $aVars;
};

const $aPhp_ExtractLocals = function($saBody) {
	JSOL.use($mPhp_ReadWord, $aPhp_ExtractVars, $iComp_FindCloseParen);
	let $aLocals = [];
	let $i = 0;
	const $iLen = Str.len($saBody);
	
	while ($i < $iLen) {
		const $bIsFunc = Str.sub($saBody, $i, 8) === "function";
		if ($bIsFunc === true && !$bPhp_IsIdentChar(Str.sub($saBody, $i + 8, 1))) {
			let $iParen = $i + 8;
			while ($iParen < $iLen && Str.sub($saBody, $iParen, 1) !== "(") { $iParen = $iParen + 1; }
			if ($iParen < $iLen) {
				const $iPClose = $iComp_FindCloseParen($saBody, $iParen);
				if ($iPClose !== -1) {
					const $saInnerParams = Str.sub($saBody, $iParen + 1, $iPClose - $iParen - 1);
					const $aInnerVars = $aPhp_ExtractVars($saInnerParams);
					const $iICount = Arr.len($aInnerVars);
					for (let $iK = 0; $iK < $iICount; $iK = $iK + 1) { Arr.push($aLocals, $aInnerVars[$iK]); }
				}
			}
			$i = $i + 8; continue;
		}

		let $bIsDecl = false;
		let $iAfterDecl = $i;
		if (Str.sub($saBody, $i, 6) === "const ") { $bIsDecl = true; $iAfterDecl = $i + 6; } 
		else if (Str.sub($saBody, $i, 4) === "let ") { $bIsDecl = true; $iAfterDecl = $i + 4; }

		if ($bIsDecl === true) {
			while ($iAfterDecl < $iLen && (Str.sub($saBody, $iAfterDecl, 1) === " " || Str.sub($saBody, $iAfterDecl, 1) === "\n" || Str.sub($saBody, $iAfterDecl, 1) === "\r" || Str.sub($saBody, $iAfterDecl, 1) === "\t")) {
				$iAfterDecl = $iAfterDecl + 1;
			}
			if (Str.sub($saBody, $iAfterDecl, 1) === "$") {
				const $mWord = $mPhp_ReadWord($saBody, $iAfterDecl);
				Arr.push($aLocals, $mWord["word"]);
			}
			$i = $iAfterDecl; continue;
		}
		$i = $i + 1;
	}
	return $aLocals;
};

const $mPhp_AnalyzeClosure = function($saCode, $iFuncStart) {
	JSOL.use($iComp_FindCloseParen, $iComp_FindCloseBrace, $aPhp_ExtractVars, $aPhp_ExtractLocals);
	
	let $iParenOpen = $iFuncStart + 8;
	const $iLen = Str.len($saCode);
	while ($iParenOpen < $iLen && Str.sub($saCode, $iParenOpen, 1) !== "(" && Str.sub($saCode, $iParenOpen, 1) !== "{") {
		$iParenOpen = $iParenOpen + 1;
	}
	if ($iParenOpen >= $iLen || Str.sub($saCode, $iParenOpen, 1) !== "(") { return Map.create("valid", false); }

	const $iParenClose = $iComp_FindCloseParen($saCode, $iParenOpen);
	if ($iParenClose === -1) { return Map.create("valid", false); }

	let $iBraceOpen = $iParenClose + 1;
	while ($iBraceOpen < $iLen && Str.sub($saCode, $iBraceOpen, 1) !== "{" && Str.sub($saCode, $iBraceOpen, 1) !== "(") {
		$iBraceOpen = $iBraceOpen + 1;
	}
	if ($iBraceOpen >= $iLen || Str.sub($saCode, $iBraceOpen, 1) !== "{") { return Map.create("valid", false); }

	const $iBraceClose = $iComp_FindCloseBrace($saCode, $iBraceOpen);
	if ($iBraceClose === -1) { return Map.create("valid", false); }

	const $saParamsStr = Str.sub($saCode, $iParenOpen + 1, $iParenClose - $iParenOpen - 1);
	const $saBody = Str.sub($saCode, $iParenOpen + 1, $iBraceClose - $iParenOpen - 1);

	if (Str.indexOf($saBody, "JSOL.use") !== -1) { return Map.create("valid", false); }

	const $aParams = $aPhp_ExtractVars($saParamsStr);
	const $aAllVars = $aPhp_ExtractVars($saBody);
	const $aLocals = $aPhp_ExtractLocals($saBody);

	let $aFree = [];
	const $iAllCount = Arr.len($aAllVars);
	for (let $iV = 0; $iV < $iAllCount; $iV = $iV + 1) {
		const $saVar = $aAllVars[$iV];
		if (Arr.indexOf($aParams, $saVar) === -1 && Arr.indexOf($aLocals, $saVar) === -1 && Arr.indexOf($aFree, $saVar) === -1) {
			Arr.push($aFree, $saVar);
		}
	}

	return Map.create("valid", true, "free", $aFree, "parenClose", $iParenClose);
};

const $saExtractPHPUse = function($saCode) {
	JSOL.use($bPhp_IsIdentChar, $mPhp_AnalyzeClosure);
	let $saResult = $saCode;
	let $iFunc = Str.len($saResult) - 8;

	while ($iFunc >= 0) {
		if (Str.sub($saResult, $iFunc, 8) !== "function") {
			$iFunc = $iFunc - 1; continue;
		}

		const $bPrev = $iFunc === 0 || !$bPhp_IsIdentChar(Str.sub($saResult, $iFunc - 1, 1));
		const $bNext = $iFunc + 8 === Str.len($saResult) || !$bPhp_IsIdentChar(Str.sub($saResult, $iFunc + 8, 1));
		if (!$bPrev || !$bNext) { $iFunc = $iFunc - 1; continue; }

		const $mAnalysis = $mPhp_AnalyzeClosure($saResult, $iFunc);
		if ($mAnalysis["valid"] === true) {
			const $aFree = $mAnalysis["free"];
			if (Arr.len($aFree) > 0) {
				let $aRefFree = [];
				const $iFreeCount = Arr.len($aFree);
				for (let $iF = 0; $iF < $iFreeCount; $iF = $iF + 1) {
					Arr.push($aRefFree, "&$" + Str.sub($aFree[$iF], 1, Str.len($aFree[$iF]) - 1));
				}
				const $saUseClause = " use (" + Arr.join($aRefFree, ", ") + ")";
				const $iParenClose = $mAnalysis["parenClose"];
				const $saBefore = Str.sub($saResult, 0, $iParenClose + 1);
				const $saAfter = Str.sub($saResult, $iParenClose + 1, Str.len($saResult) - ($iParenClose + 1));
				$saResult = $saBefore + "" + $saUseClause + "" + $saAfter;
			}
		}
		$iFunc = $iFunc - 1;
	}
	return $saResult;
};