
// @JSOL v0.2.96 - Python Target Compiler
// [!] ARCHITECTURE NOTICE: This Python target compiler has a direct structural dependency on 
// js-compiler.jsol. It expects the source code to have passed through the JavaScript base 
// transformations (like ternary and brace stripping) before applying Python-specific rules.
//
// Runs on MASKED code, AFTER $sCompileToJS(..., pythonRules) has already
// substituted primitives (Str.*, Arr.*, Map.*, Cast.*), and BEFORE $sIndentCode.
//
// Scope: translates JS-shaped control-flow syntax to Python syntax, but
// DELIBERATELY LEAVES EVERY "{" AND "}" IN PLACE. $sIndentCode depends on
// brace-depth counting to indent correctly; stripping braces here would blind
// it. Braces get removed in a LATER, separate pass, only after indentation is
// already resolved and they're pure noise.
//
// Handled in this pass:
//   - Operators: && -> and, || -> or, ! -> not (word-boundary safe, doesn't
//     touch "!=" or "!==" ), === -> ==, !== -> !=
//   - Keywords: null -> None, true -> True, false -> False (word-boundary safe)
//   - if (cond) {      -> if cond: {
//   - else if (cond) { -> elif cond: {
//   - else {           -> else: {
//   - while (cond) {   -> while cond: {
//   - switch (cond) {  -> converts to while loop with elif chain
//   - for (init; cond; step) { -> converts to while loop mathematically
//
// NOT handled in this pass, on purpose (separate, harder problem):
//   - Ternary (cond ? a : b) -> (a if cond else b)
//
// Usage: standalone first, same discipline as indenter.jsol. Do not wire into
// engine.jsol until validated against real examples.


const $aTranslateCommentTokensToPython = function($aTokens) {
    let $aResult = [];
    for (let $i = 0; $i < Arr.count($aTokens); $i = $i + 1) {
        const $mToken = $aTokens[$i];
        const $sKey = $mToken["key"];
        const $sVal = $mToken["value"];

        if (Str.sub($sVal, 0, 2) === "//") {
            const $sRest = Str.sub($sVal, 2, Str.len($sVal) - 2);
            Arr.push($aResult, Map.create("key", $sKey, "value", "#" + "" + $sRest));

        } else if (Str.sub($sVal, 0, 2) === "/*") {
            let $sInner = Str.sub($sVal, 2, Str.len($sVal) - 2);
            if (Str.sub($sInner, Str.len($sInner) - 2, 2) === "*/") {
                $sInner = Str.sub($sInner, 0, Str.len($sInner) - 2);
            }
            const $sConverted = "#" + "" + Str.replace($sInner, "\n", "\n#");
            Arr.push($aResult, Map.create("key", $sKey, "value", $sConverted));

        } else {
            // Not a comment (starts with a quote char) — a real string
            // literal, leave it byte-for-byte untouched.
            Arr.push($aResult, Map.create("key", $sKey, "value", $sVal));
        }
    }
    return $aResult;
};

const $bIsWhitespaceCharTrim = function($sCh) {
    if ($sCh === " ") { return true; }
    if ($sCh === "\t") { return true; }
    if ($sCh === "\n") { return true; }
    if ($sCh === "\r") { return true; }
    return false;
};

const $sTrimWhitespace = function($sVal) {
    JSOL.use($bIsWhitespaceCharTrim);
    const $iLen = Str.len($sVal);
    let $iStart = 0;
    while ($iStart < $iLen && $bIsWhitespaceCharTrim(Str.sub($sVal, $iStart, 1)) === true) {
        $iStart = $iStart + 1;
    }
    let $iEnd = $iLen;
    while ($iEnd > $iStart && $bIsWhitespaceCharTrim(Str.sub($sVal, $iEnd - 1, 1)) === true) {
        $iEnd = $iEnd - 1;
    }
    return Str.sub($sVal, $iStart, $iEnd - $iStart);
};

const $bIsIdentChar = function($sCh) {
    if ($sCh === "_") { return true; }
    if ($sCh === "$") { return true; }
    if ($sCh >= "a" && $sCh <= "z") { return true; }
    if ($sCh >= "A" && $sCh <= "Z") { return true; }
    if ($sCh >= "0" && $sCh <= "9") { return true; }
    return false;
};

const $mReadWord = function($sCode, $iStart) {
    JSOL.use($bIsIdentChar);
    const $iLen = Str.len($sCode);
    let $i = $iStart;
    while ($i < $iLen && $bIsIdentChar(Str.sub($sCode, $i, 1)) === true) {
        $i = $i + 1;
    }
    return Map.create("word", Str.sub($sCode, $iStart, $i - $iStart), "end", $i);
};

const $iSkipWhitespace = function($sCode, $iStart) {
    const $iLen = Str.len($sCode);
    let $i = $iStart;
    while ($i < $iLen) {
        const $sCh = Str.sub($sCode, $i, 1);
        if ($sCh === " " || $sCh === "\t" || $sCh === "\n" || $sCh === "\r") {
            $i = $i + 1;
        } else {
            return $i;
        }
    }
    return $i;
};

const $mReadBalancedParens = function($sCode, $iOpenIndex) {
    const $iLen = Str.len($sCode);
    let $iDepth = 0;
    let $i = $iOpenIndex;
    let $iInsideStart = -1;

    while ($i < $iLen) {
        const $sCh = Str.sub($sCode, $i, 1);
        if ($sCh === "(") {
            $iDepth = $iDepth + 1;
            if ($iDepth === 1) {
                $iInsideStart = $i + 1;
            }
        } else if ($sCh === ")") {
            $iDepth = $iDepth - 1;
            if ($iDepth === 0) {
                return Map.create(
                    "inside", Str.sub($sCode, $iInsideStart, $i - $iInsideStart),
                    "end", $i + 1
                );
            }
        }
        $i = $i + 1;
    }
    return Map.create("inside", "", "end", $iLen);
};

const $sTranslateOperators = function($sExpr) {
    JSOL.use($bIsIdentChar, $mReadWord);
    let $sResult = "";
    let $i = 0;
    const $iLen = Str.len($sExpr);

    while ($i < $iLen) {
        const $sCh = Str.sub($sExpr, $i, 1);
        const $bAtBoundary = ($i === 0) || ($bIsIdentChar(Str.sub($sExpr, $i - 1, 1)) === false);

        if ($bAtBoundary === true && $bIsIdentChar($sCh) === true) {
            const $mWord = $mReadWord($sExpr, $i);
            const $sWord = $mWord["word"];

            if ($sWord === "true") {
                $sResult = $sResult + "" + "True";
                $i = $mWord["end"];
            } else if ($sWord === "false") {
                $sResult = $sResult + "" + "False";
                $i = $mWord["end"];
            } else if ($sWord === "null") {
                $sResult = $sResult + "" + "None";
                $i = $mWord["end"];
            } else {
                $sResult = $sResult + "" + $sWord;
                $i = $mWord["end"];
            }
        } else {
            const $sTwo = Str.sub($sExpr, $i, 2);
            const $sThree = Str.sub($sExpr, $i, 3);

            if ($sThree === "===") {
                $sResult = $sResult + "" + "==";
                $i = $i + 3;
            } else if ($sThree === "!==") {
                $sResult = $sResult + "" + "!=";
                $i = $i + 3;
            } else if ($sTwo === "&&") {
                $sResult = $sResult + "" + "and";
                $i = $i + 2;
            } else if ($sTwo === "||") {
                $sResult = $sResult + "" + "or";
                $i = $i + 2;
            } else if ($sTwo === "!=") {
                $sResult = $sResult + "" + "!=";
                $i = $i + 2;
            } else if (Str.sub($sExpr, $i, 1) === "!") {
                $sResult = $sResult + "" + "not ";
                $i = $i + 1;
            } else {
                $sResult = $sResult + "" + $sCh;
                $i = $i + 1;
            }
        }
    }

    return $sResult;
};

const $mReadBalancedBraces = function($sCode, $iOpenIndex) {
    const $iLen = Str.len($sCode);
    let $iDepth = 0;
    let $i = $iOpenIndex;
    let $iInsideStart = -1;
    while ($i < $iLen) {
        const $sCh = Str.sub($sCode, $i, 1);
        if ($sCh === "{") {
            $iDepth = $iDepth + 1;
            if ($iDepth === 1) { $iInsideStart = $i + 1; }
        } else if ($sCh === "}") {
            $iDepth = $iDepth - 1;
            if ($iDepth === 0) {
                return Map.create("inside", Str.sub($sCode, $iInsideStart, $i - $iInsideStart), "end", $i + 1);
            }
        }
        $i = $i + 1;
    }
    return Map.create("inside", "", "end", $iLen);
};

const $sConvertControlFlowToPython = function($sMaskedCode) {
    JSOL.use($mReadWord, $iSkipWhitespace, $mReadBalancedParens, $mReadBalancedBraces, $sTranslateOperators, $bIsIdentChar, $sTrimWhitespace, $sConvertControlFlowToPython);

    let $sResult = "";
    let $i = 0;
    const $iLen = Str.len($sMaskedCode);

    while ($i < $iLen) {
        const $sCh = Str.sub($sMaskedCode, $i, 1);
        const $bAtBoundary = ($i === 0) || ($bIsIdentChar(Str.sub($sMaskedCode, $i - 1, 1)) === false);

        if ($bAtBoundary === true && $bIsIdentChar($sCh) === true) {
            const $mWord = $mReadWord($sMaskedCode, $i);
            const $sWord = $mWord["word"];

            if ($sWord === "null") {
                $sResult = $sResult + "" + "None";
                $i = $mWord["end"];
            } else if ($sWord === "true") {
                $sResult = $sResult + "" + "True";
                $i = $mWord["end"];
            } else if ($sWord === "false") {
                $sResult = $sResult + "" + "False";
                $i = $mWord["end"];
            } else if ($sWord === "if") {
                let $iAfter = $iSkipWhitespace($sMaskedCode, $mWord["end"]);
                if (Str.sub($sMaskedCode, $iAfter, 1) === "(") {
                    const $mParens = $mReadBalancedParens($sMaskedCode, $iAfter);
                    $sResult = $sResult + "" + "if " + "" + $sTranslateOperators($mParens["inside"]) + "" + ":";
                    $i = $mParens["end"];
                } else {
                    $sResult = $sResult + "" + $sWord;
                    $i = $mWord["end"];
                }
            } else if ($sWord === "switch") {
                let $iAfter = $iSkipWhitespace($sMaskedCode, $mWord["end"]);
                if (Str.sub($sMaskedCode, $iAfter, 1) === "(") {
                    const $mParens = $mReadBalancedParens($sMaskedCode, $iAfter);
                    const $iAfterParens = $iSkipWhitespace($sMaskedCode, $mParens["end"]);
                    if (Str.sub($sMaskedCode, $iAfterParens, 1) === "{") {
                        const $mBraces = $mReadBalancedBraces($sMaskedCode, $iAfterParens);
                        const $sBody = $sConvertControlFlowToPython($mBraces["inside"]);
                        $sResult = $sResult + "" + "_jsol_switch = " + "" + $sTranslateOperators($mParens["inside"]) + "" + "\n_jsol_done = False\nwhile not _jsol_done: {\n_jsol_done = True\nif False: pass" + "" + $sBody + "\n}";
                        $i = $mBraces["end"];
                    } else {
