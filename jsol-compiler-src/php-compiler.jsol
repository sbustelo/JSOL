// @JSOL v0.2.94 - Self-Hosted PHP Target Compiler (Dynamic SSOT Iteration)
const $sCompileToPHP = function($sMaskedCode, $sPrefix, $sSuffix, $aRules) {
    JSOL.use($sRegexReplace);
    
    const $fProcessBlock = function($sCode, $sKeyword, $bUnwrap) {
        let $sResult = $sCode;
        let $bContinue = true;
        let $iOffset = 0;
        while ($bContinue === true) {
            const $iSearchLen = Str.len($sResult) - $iOffset;
            if ($iSearchLen <= 0) {
                $bContinue = false;
                continue;
            }
            const $sSearchArea = Str.sub($sResult, $iOffset, $iSearchLen);
            const $iRelIdx = Str.indexOf($sSearchArea, $sKeyword);
            
            if ($iRelIdx === -1) {
                $bContinue = false;
            } else {
                const $iStartIdx = $iOffset + $iRelIdx;
                const $iTailLen = Str.len($sResult) - $iStartIdx;
                const $sTail = Str.sub($sResult, $iStartIdx, $iTailLen);
                const $iRelOpenBrace = Str.indexOf($sTail, "{");
                const $iOpenBrace = $iRelOpenBrace === -1 ? -1 : $iStartIdx + $iRelOpenBrace;
                
                if ($iOpenBrace === -1) {
                    $bContinue = false;
                } else {
                    let $iBraceCount = 1;
                    let $iCloseBrace = -1;
                    const $iRLen = Str.len($sResult);
                    for (let $i = $iOpenBrace + 1; $i < $iRLen; $i = $i + 1) {
                        const $sChar = Str.sub($sResult, $i, 1);
                        if ($sChar === "{") { $iBraceCount = $iBraceCount + 1; }
                        if ($sChar === "}") { $iBraceCount = $iBraceCount - 1; }
                        if ($iBraceCount === 0) {
                            $iCloseBrace = $i;
                            break;
                        }
                    }
                    
                    if ($iCloseBrace === -1) {
                        $bContinue = false;
                    } else {
                        let $iEndIdx = $iCloseBrace + 1;
                        let $bFindingEnd = true;
                        while ($iEndIdx < $iRLen && $bFindingEnd === true) {
                            const $sChar = Str.sub($sResult, $iEndIdx, 1);
                            if ($sChar === " " || $sChar === "\n" || $sChar === "\r" || $sChar === ")" || $sChar === ";") {
                                $iEndIdx = $iEndIdx + 1;
                            } else {
                                $bFindingEnd = false;
                            }
                        }
                        
                        const $sBefore = Str.sub($sResult, 0, $iStartIdx);
                        const $iAfterLen = Str.len($sResult) - $iEndIdx;
                        const $sAfter = Str.sub($sResult, $iEndIdx, $iAfterLen);
                        
                        if ($bUnwrap === true) {
                            const $iInnerLen = $iCloseBrace - $iOpenBrace - 1;
                            const $sInner = Str.sub($sResult, $iOpenBrace + 1, $iInnerLen);
                            $sResult = $sBefore + "" + $sInner + "" + $sAfter;
                            $iOffset = Str.len($sBefore) + Str.len($sInner);
                        } else {
                            $sResult = $sBefore + "" + $sAfter;
                            $iOffset = Str.len($sBefore);
                        }
                    }
                }
            }
        }
        return $sResult;
    };

const $fProcessCall = function($sCode, $sKeyword, $sTemplate) {
        let $sResult = $sCode;
        let $bContinue = true;
        let $iOffset = 0;
        while ($bContinue === true) {
            const $iSearchLen = Str.len($sResult) - $iOffset;
            if ($iSearchLen <= 0) {
                $bContinue = false;
                continue;
            }
            const $sSearchArea = Str.sub($sResult, $iOffset, $iSearchLen);
            const $iRelIdx = Str.indexOf($sSearchArea, $sKeyword);
            
            if ($iRelIdx === -1) {
                $bContinue = false;
            } else {
                const $iStartIdx = $iOffset + $iRelIdx;
                const $iKwLen = Str.len($sKeyword);
                const $iOpenParen = $iStartIdx + $iKwLen - 1;
                let $iParenCount = 1;
                let $iBracketCount = 0;
                let $iBraceCount = 0;
                let $bInStr = false;
                let $iCloseParen = -1;
                let $aArgs = [];
                let $iCurrentArgStart = $iOpenParen + 1;
                const $iRLen = Str.len($sResult);
                
                for (let $i = $iOpenParen + 1; $i < $iRLen; $i = $i + 1) {
                    const $sChar = Str.sub($sResult, $i, 1);
                    const $sPrev = Str.sub($sResult, $i - 1, 1);
                    
                    if ($sChar === "\"" && $sPrev !== "\\") { $bInStr = !$bInStr; }
                    
                    if ($bInStr === false) {
                        if ($sChar === "(") { $iParenCount = $iParenCount + 1; }
                        if ($sChar === ")") { $iParenCount = $iParenCount - 1; }
                        if ($sChar === "[") { $iBracketCount = $iBracketCount + 1; }
                        if ($sChar === "]") { $iBracketCount = $iBracketCount - 1; }
                        if ($sChar === "{") { $iBraceCount = $iBraceCount + 1; }
                        if ($sChar === "}") { $iBraceCount = $iBraceCount - 1; }
                    }
                    
                    if ($sChar === "," && $iParenCount === 1 && $iBracketCount === 0 && $iBraceCount === 0 && $bInStr === false) {
                        const $iArgLen1 = $i - $iCurrentArgStart;
                        const $sArgVal1 = Str.sub($sResult, $iCurrentArgStart, $iArgLen1);
                        Arr.push($aArgs, $sArgVal1);
                        $iCurrentArgStart = $i + 1;
                    } else if ($iParenCount === 0) {
                        const $iArgLen2 = $i - $iCurrentArgStart;
                        const $sArgVal2 = Str.sub($sResult, $iCurrentArgStart, $iArgLen2);
                        Arr.push($aArgs, $sArgVal2);
                        $iCloseParen = $i;
                        break;
                    }
                }
                
                if ($iCloseParen === -1) {
                    $bContinue = false;
                } else {
                    const $sBefore = Str.sub($sResult, 0, $iStartIdx);
                    const $iAfterLen = Str.len($sResult) - $iCloseParen - 1;
                    const $sAfter = Str.sub($sResult, $iCloseParen + 1, $iAfterLen);
                    
                    let $sRep = $sTemplate;
                    if (Str.indexOf($sTemplate, "{*}") !== -1) {
                        $sRep = Str.replace($sRep, "{*}", Arr.join($aArgs, ", "));
                    } else {
                        const $iArgsCount = Arr.count($aArgs);
                        for (let $iK = 0; $iK < $iArgsCount; $iK = $iK + 1) {
                            const $sPlaceholder = "{" + "" + $iK + "" + "}";
                            $sRep = Str.replace($sRep, $sPlaceholder, $aArgs[$iK]);
                        }
                    }
                    
                    $sResult = $sBefore + "" + $sRep + "" + $sAfter;
                    $iOffset = $iStartIdx;
                }
            }
        }
        return $sResult;
    };

    let $sTransformed = $sMaskedCode;
    
    // PHP Target Pre-Processing (Native raw manipulations not mapped in SSOT)
    const $aPrefixes = ["\n", "\r\n", "\t", " ", "("];
    for (let $iP = 0; $iP < 5; $iP = $iP + 1) {
        $sTransformed = Str.replace($sTransformed, $aPrefixes[$iP] + "const ", $aPrefixes[$iP]);
        $sTransformed = Str.replace($sTransformed, $aPrefixes[$iP] + "let ", $aPrefixes[$iP]);
        $sTransformed = Str.replace($sTransformed, $aPrefixes[$iP] + "var ", $aPrefixes[$iP]);
    }
    if (Str.indexOf($sTransformed, "const ") === 0) { $sTransformed = Str.sub($sTransformed, 6, Str.len($sTransformed) - 6); }
    if (Str.indexOf($sTransformed, "let ") === 0) { $sTransformed = Str.sub($sTransformed, 4, Str.len($sTransformed) - 4); }
    if (Str.indexOf($sTransformed, "var ") === 0) { $sTransformed = Str.sub($sTransformed, 4, Str.len($sTransformed) - 4); }

    // Dynamic SSOT Rules Iterator
    const $iRulesCount = Arr.count($aRules);
    for (let $iR = 0; $iR < $iRulesCount; $iR = $iR + 1) {
        const $mRule = $aRules[$iR];
        const $sType = $mRule["type"];
        const $sId = $mRule["id"];
        const $sTemplate = $mRule["template"];

        if ($sType === "block") {
            $sTransformed = $fProcessBlock($sTransformed, $sId, $sTemplate === "unwrap");
        } else if ($sType === "regex") {
            $sTransformed = $sRegexReplace($mRule["search"], $sTemplate, $sTransformed, 'g');
        } else if ($sType === "replace") {
            $sTransformed = Str.replace($sTransformed, $sId, $sTemplate);
        } else if ($sType === "call") {
            $sTransformed = $fProcessCall($sTransformed, $sId + "(", $sTemplate);
        }
    }

	// PHP Target Post-Processing
    $sTransformed = Str.replace($sTransformed, 'JSOL.', 'JSOL::');

    $sTransformed = $sRegexReplace('(__JSOL_(TOKEN|STR|COM)_[0-9]+__)\\s*\\+', '$1 .', $sTransformed, 'g');
    $sTransformed = $sRegexReplace('\\+\\s*(__JSOL_(TOKEN|STR|COM)_[0-9]+__)', '. $1', $sTransformed, 'g');

    $sTransformed = $sRegexReplace('(\\$s[A-Za-z0-9_]*)\\s*\\+', '$1 .', $sTransformed, 'g');
    $sTransformed = $sRegexReplace('\\+\\s*(\\$s[A-Za-z0-9_]*)', '. $1', $sTransformed, 'g');

// ANTI-SABOTAGE: Post-processor to forcibly inject pass-by-reference (&$)
    // to all variables listed inside a PHP `use (...)` block, allowing
    // closures to see themselves and sibling functions upon instantiation.
    let $bFixUse = true;
    let $iUseOffset = 0;
    while ($bFixUse === true) {
        const $iSearchLen = Str.len($sTransformed) - $iUseOffset;
        if ($iSearchLen <= 0) {
            $bFixUse = false;
            continue;
        }
        const $sSearchArea = Str.sub($sTransformed, $iUseOffset, $iSearchLen);
        const $iUseRel = Str.indexOf($sSearchArea, "use (");
        
        if ($iUseRel === -1) {
            $bFixUse = false;
        } else {
            const $iStart = $iUseOffset + $iUseRel + 5;
            const $iTailLen = Str.len($sTransformed) - $iStart;
            const $sTail = Str.sub($sTransformed, $iStart, $iTailLen);
            const $iEndRel = Str.indexOf($sTail, ")");
            const $iEnd = $iStart + $iEndRel;
            
            const $sArgs = Str.sub($sTransformed, $iStart, $iEnd - $iStart);
            let $sRefArgs = $sRegexReplace("\\$", "&$", $sArgs, "g");
            $sRefArgs = $sRegexReplace("&&\\$", "&$", $sRefArgs, "g"); // Previene duplicar si ya tenía &
            
            const $sBefore = Str.sub($sTransformed, 0, $iStart);
            const $iAfterLen = Str.len($sTransformed) - $iEnd;
            const $sAfter = Str.sub($sTransformed, $iEnd, $iAfterLen);
            
            $sTransformed = $sBefore + "" + $sRefArgs + "" + $sAfter;
            $iUseOffset = $iStart + Str.len($sRefArgs) + 1; // Avanza el puntero
        }
    }

    let $sFinalOutput = $sPrefix + "" + $sTransformed + "" + $sSuffix;
    if (Str.indexOf($sFinalOutput, "<?php") === -1) {
        $sFinalOutput = "<?php\n" + $sFinalOutput;
    }
    return $sFinalOutput;

};